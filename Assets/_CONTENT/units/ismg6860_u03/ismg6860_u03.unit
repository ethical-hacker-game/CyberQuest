    {
      "personaID": "whitehat",
      "personaName": "Whitehat Hacker",
      "personaDescription": "A whitehat hacker protects affected people, preserves evidence, avoids credential collection, and turns social-engineering findings into practical reporting and training.",
      "messagePlayerJoinedHeader": "Whitehat Path Chosen",
      "messagePlayerJoined": "You are keeping the response disciplined: preserve evidence, protect staff, and reduce pressure without blaming targets.",
      "messagePlayerUnloyalHeader": "Whitehat Discipline Challenged",
      "messagePlayerUnloyal": "That choice moved away from responsible incident handling. Refocus on authorization, evidence quality, and harm reduction.",
      "personaPictureID": "persona_white"
    },
    {
      "personaID": "blackhat",
      "personaName": "Blackhat Hacker",
      "personaDescription": "A blackhat hacker treats influence chains as leverage and studies which human pressure points can be used for personal advantage.",
      "messagePlayerJoinedHeader": "Blackhat Path Chosen",
      "messagePlayerJoined": "You are reading the campaign like an attacker: every channel, trigger, and trust failure can become leverage if kept private.",
      "messagePlayerUnloyalHeader": "Blackhat Instincts Checked",
      "messagePlayerUnloyal": "That choice protected the targets instead of exploiting the opening. The blackhat path values leverage over trust.",
      "personaPictureID": "persona_black"
    },
    {
      "personaID": "hacktivist",
      "personaName": "Hacktivist",
      "personaDescription": "A hacktivist uses social-engineering evidence to pressure institutions, protect communities, and force public accountability with careful redaction.",
      "messagePlayerJoinedHeader": "Hacktivist Path Chosen",
      "messagePlayerJoined": "You are framing Blue Lantern around public impact: volunteers and visitors deserve timely warnings when institutions move slowly.",
      "messagePlayerUnloyalHeader": "Hacktivist Purpose Challenged",
      "messagePlayerUnloyal": "That choice served process more than pressure. Keep public consequence at the center if you want the hacktivist path.",
      "personaPictureID": "persona_hacktivist"
    }
  ]
