    },
    {
      "persona": "Blackhat Hacker",
      "questName": "Enumeration Pen Testing",
      "questDescription": "Reyes Calloway wants the difference between observed activity and speculative reach made explicit. Map only the session path the evidence supports.",
      "questCompleteText": "<b>Reyes Calloway:</b> The external-source session on the historian is verified. DNS, IKE, SNMP, and directory evidence add context without proving traversal between those systems.",
      "questCharacterID": "u05_reyes_calloway",
      "appScenarioID": ""
    },
    {
