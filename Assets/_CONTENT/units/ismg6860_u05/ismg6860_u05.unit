  "personas": [
    {
      "personaID": "whitehat",
      "personaName": "Whitehat Hacker",
      "personaDescription": "A whitehat hacker enumerates only what the authorization covers, records evidence that survives review, and turns protocol findings into remediation the client can act on.",
      "messagePlayerJoinedHeader": "Whitehat Path Chosen",
      "messagePlayerJoined": "You are keeping the enumeration disciplined: query what the scope allows, change nothing, and give Halloway findings they can actually fix.",
      "messagePlayerUnloyalHeader": "Whitehat Discipline Challenged",
      "messagePlayerUnloyal": "That choice moved away from authorized enumeration practice. Regain trust by staying read-only, documenting cleanly, and pointing at remediation.",
      "personaPictureID": "persona_white"
    },
    {
      "personaID": "blackhat",
      "personaName": "Blackhat Hacker",
      "personaDescription": "A blackhat hacker reads enumeration output as an access map, values the account nobody is watching, and treats a client's blind spot as inventory.",
      "messagePlayerJoinedHeader": "Blackhat Path Chosen",
      "messagePlayerJoined": "You are reading the enumeration like an attacker: every share, every stale account, every open tunnel is something Halloway does not know it still owns.",
      "messagePlayerUnloyalHeader": "Blackhat Instincts Checked",
      "messagePlayerUnloyal": "That choice closed the gap instead of keeping it open. The blackhat path values quiet access over the client's peace of mind.",
      "personaPictureID": "persona_black"
    },
    {
      "personaID": "hacktivist",
      "personaName": "Hacktivist",
      "personaDescription": "A hacktivist measures enumeration findings by who gets hurt if they stay hidden, and pushes for disclosure when an institution would rather quietly patch and move on.",
      "messagePlayerJoinedHeader": "Hacktivist Path Chosen",
      "messagePlayerJoined": "You are framing the enumeration around consequence: the people on that plant floor share a network with systems nobody has managed in years.",
      "messagePlayerUnloyalHeader": "Hacktivist Purpose Challenged",
      "messagePlayerUnloyal": "That choice served the engagement more than the people inside it. Keep who is exposed at the center if you want the hacktivist path.",
      "personaPictureID": "persona_hacktivist"
    }
  ]
}