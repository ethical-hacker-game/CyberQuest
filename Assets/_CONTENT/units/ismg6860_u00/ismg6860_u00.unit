  "personas": [
    {
      "personaID": "michele",
      "personaName": "Whitehat Hacker",
      "personaDescription": "A <b>whitehat hacker</b> works with permission to protect systems and people. You document findings, help the owner fix the cause, and verify that the repair works. Michele is your operations contact for this case.",
      "messagePlayerJoinedHeader": "Whitehat Path Chosen",
      "messagePlayerJoined": "You are taking the <b>Whitehat</b> path: turn the evidence into a repair the owner can reproduce and verify. Michele will help you prepare the handoff.",
      "messagePlayerUnloyalHeader": "Whitehat Code Challenged",
      "messagePlayerUnloyal": "Keep your actions authorized and your findings reproducible. Protecting the service means respecting scope and following through on verification.",
      "personaPictureID": "persona_white"
    },
    {
      "personaID": "ana",
      "personaName": "Hacktivist",
      "personaDescription": "A <b>hacktivist</b> uses technical evidence to advocate for people and demand accountability. You explain the impact, press for a response, and protect sensitive details so the message does not create new harm. Ana is your communications contact for this case.",
      "messagePlayerJoinedHeader": "Hacktivist Path Chosen",
      "messagePlayerJoined": "You are taking the <b>Hacktivist</b> path: use the evidence to advocate for affected users and press for accountability. Ana will help you prepare a careful brief.",
      "messagePlayerUnloyalHeader": "The Cause Challenged",
      "messagePlayerUnloyal": "Keep the people affected at the center of the work. Ground your claims in evidence and avoid spreading details that would make the exposure worse.",
      "personaPictureID": "persona_hacktivist"
    }
  ]
