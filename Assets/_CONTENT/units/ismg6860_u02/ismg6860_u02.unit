  "personas": [
    {
      "personaID": "whitehat",
      "personaName": "Whitehat Hacker",
      "personaDescription": "A whitehat hacker keeps scanning authorized, interprets evidence defensibly, and turns findings into practical remediation.",
      "messagePlayerJoinedHeader": "Whitehat Path Chosen",
      "messagePlayerJoined": "You are keeping the scan disciplined: stay inside scope, preserve evidence, and help Asterlink fix the exposure before launch.",
      "messagePlayerUnloyalHeader": "Whitehat Discipline Challenged",
      "messagePlayerUnloyal": "That choice moved away from authorized scanning practice. Regain trust by focusing on scope, evidence quality, and remediation.",
      "personaPictureID": "persona_white"
    },
    {
      "personaID": "blackhat",
      "personaName": "Blackhat Hacker",
      "personaDescription": "A blackhat hacker treats scan maps as leverage and values hidden access intelligence over authorization or harm reduction.",
      "messagePlayerJoinedHeader": "Blackhat Path Chosen",
      "messagePlayerJoined": "You are looking at the scan map like an attacker: every route, service, and banner can become leverage if you keep it private.",
      "messagePlayerUnloyalHeader": "Blackhat Instincts Checked",
      "messagePlayerUnloyal": "That choice protected the client instead of exploiting the opening. The blackhat path values leverage over trust.",
      "personaPictureID": "persona_black"
    },
    {
      "personaID": "hacktivist",
      "personaName": "Hacktivist",
      "personaDescription": "A hacktivist uses scanning evidence to pressure institutions, expose negligence, and protect communities with careful redaction.",
      "messagePlayerJoinedHeader": "Hacktivist Path Chosen",
      "messagePlayerJoined": "You are framing the scan around public impact: riders deserve accountability when vendor access can touch civic systems.",
      "messagePlayerUnloyalHeader": "Hacktivist Purpose Challenged",
      "messagePlayerUnloyal": "That choice served process more than pressure. Keep public consequence at the center if you want the hacktivist path.",
      "personaPictureID": "persona_hacktivist"
    }
  ]
