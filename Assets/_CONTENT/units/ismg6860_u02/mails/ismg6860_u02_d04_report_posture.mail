    {
      "persona": "Whitehat Hacker",
      "author": "Asterlink Incident Desk <incident@asterlinktransit.com>",
      "subject": "Draft handoff posture",
      "shortSummary": "The final communication posture must be chosen before the finding is handed off.",
      "date": "0001-01-01T00:00:00",
      "body": "{player},\n\nDraft handoff should go to the authorized incident owner with full technical detail: host, services, packet evidence, IPv6 finding, firewall visibility, and recommended segmentation control.\n\nMira",
      "attachements": []
    },
    {
      "persona": "Blackhat Hacker",
      "author": "Asterlink Incident Desk <incident@asterlinktransit.com>",
      "subject": "Draft handoff posture",
      "shortSummary": "The final communication posture must be chosen before the finding is handed off.",
      "date": "0001-01-01T00:00:00",
      "body": "{player},\n\nThe private value is the route: ECHO-73, 10.42.22.41, the service map, and where monitoring sees you. Once it goes into the official packet, the leverage changes.\n\nKade",
      "attachements": []
    },
    {
      "persona": "Hacktivist",
      "author": "Asterlink Incident Desk <incident@asterlinktransit.com>",
      "subject": "Draft handoff posture",
      "shortSummary": "The final communication posture must be chosen before the finding is handed off.",
      "date": "0001-01-01T00:00:00",
      "body": "{player},\n\nThe public value is a redacted timeline: vendor access touched ticketing, controls were incomplete, and riders deserve a fix window plus disclosure. Strip live technical details before anything leaves the authorized channel.\n\nLena",
      "attachements": []
    }
  ]
}
