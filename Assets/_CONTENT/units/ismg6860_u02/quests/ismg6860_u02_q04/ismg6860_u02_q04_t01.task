      "persona": "Whitehat Hacker",
      "taskMessage": "<b>Dr. Mira Sen:</b> This discovery pass asks a limited question: which hosts respond inside the approved range? Compare the result with the expected inventory before drawing a conclusion.",
      "taskInstructions": "Run <b>nmap -sn 10.42.18.0/24</b> in the terminal and compare the returned addresses against the inventory in the discovery notes.",
      "taskQuestion": "Which host label appears unexpectedly in the approved range?",
      "taskCompleteText": "<b>Dr. Mira Sen:</b> Correct. ECHO-73 responded inside the approved range but does not appear in the expected inventory.",
      "correctAnswers": [
        "ECHO-73",
        "echo73",
        "echo 73",
        "echo_73",
        "10.42.18.73"
      ]
    },
    {
