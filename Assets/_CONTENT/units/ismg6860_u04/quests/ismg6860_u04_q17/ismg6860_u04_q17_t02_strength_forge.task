    {
      "minigameType": "StrengthForge",
      "minigameHeaderText": "Northbridge Credential Hardening",
      "durationOverride": 0,
      "difficulty": "Normal",
      "strengthForgeSettings": {
        "rounds": [
          {
            "label": "Staff Portal Account",
            "description": "Create a memorable replacement for an online account protected by throttling but exposed to dictionary and hybrid guessing.",
            "dictionaryAttack": true,
            "hybridAttack": true,
            "bruteForceAttack": false,
            "guessesPerSecond": 1000,
            "requiredCrackSeconds": 2592000,
            "maxTokens": 5,
            "memorabilityBudget": 9
          },
          {
            "label": "Privileged Service Account",
            "description": "Build a stronger credential for a privileged service whose recovered hash could face fast offline guessing.",
            "dictionaryAttack": true,
            "hybridAttack": true,
            "bruteForceAttack": true,
            "guessesPerSecond": 10000000,
            "requiredCrackSeconds": 31536000,
            "maxTokens": 6,
            "memorabilityBudget": 11
          }
        ]
      },
      "persona": "Whitehat Hacker",
      "taskMessage": "<b>Mara Voss:</b> Recommendations are easy to write and hard to live with. Northbridge has two very different problems here: a staff portal where guessing is throttled to a crawl, and a privileged service whose recovered hash could be ground through offline at speeds the portal will never see.\n\nOne complexity rule for both is how organizations end up with sticky notes on monitors. I want two replacements, each sized to the threat it will actually meet.",
      "taskInstructions": "A round clears only when every attack meter for that account survives the required time, inside its token slot and memorability limits. Rare, unusual words buy far more resistance per memorability point than leet spellings, digit suffixes, or breach-dump favorites.",
      "taskQuestion": "Forge the replacement credentials.",
      "taskCompleteText": "You produced separate credentials for online and offline risk instead of applying one vague complexity rule. The result is both defensible and usable."
    },
    {
      "minigameType": "StrengthForge",
      "minigameHeaderText": "Northbridge Credential Hardening",
      "durationOverride": 0,
