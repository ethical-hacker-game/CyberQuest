  "personas": [
    {
      "personaID": "whitehat",
      "personaName": "Whitehat Hacker",
      "personaDescription": "A whitehat hacker works with authorization, protects affected people, documents evidence carefully, and focuses on remediation instead of exploitation.",
      "messagePlayerJoinedHeader": "Whitehat Path Chosen",
      "messagePlayerJoined": "You are keeping the assessment disciplined: stay inside scope, preserve evidence, and help Northbridge fix verified weaknesses.",
      "messagePlayerUnloyalHeader": "Whitehat Discipline Challenged",
      "messagePlayerUnloyal": "That choice moved away from responsible assessment practice. Regain trust by focusing on authorization, evidence quality, and remediation.",
      "personaPictureID": "persona_white"
    },
    {
      "personaID": "blackhat",
      "personaName": "Blackhat Hacker",
      "personaDescription": "A blackhat hacker treats vulnerabilities as leverage, looks for access expansion, and values personal advantage over authorization or harm reduction.",
      "messagePlayerJoinedHeader": "Blackhat Path Chosen",
      "messagePlayerJoined": "You are looking at the assessment like an attacker: every verified weakness is leverage, every exposed path is a possible foothold.",
      "messagePlayerUnloyalHeader": "Blackhat Instincts Checked",
      "messagePlayerUnloyal": "That choice protected the client instead of exploiting the opening. If you want the blackhat path, you will need to prioritize leverage over trust.",
      "personaPictureID": "persona_black"
    },
    {
      "personaID": "hacktivist",
      "personaName": "Hacktivist",
      "personaDescription": "A hacktivist uses security findings to pressure institutions, expose negligence, and protect communities when formal channels appear too slow.",
      "messagePlayerJoinedHeader": "Hacktivist Path Chosen",
      "messagePlayerJoined": "You are framing the assessment around public impact: if leadership delays, the people affected by these systems still deserve accountability.",
      "messagePlayerUnloyalHeader": "Hacktivist Purpose Challenged",
      "messagePlayerUnloyal": "That choice served process more than pressure. If you want the hacktivist path, keep the public consequences at the center of your decisions.",
      "personaPictureID": "persona_hacktivist"
    }
  ]
