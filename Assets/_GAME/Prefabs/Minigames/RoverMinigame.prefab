  m_Name:
  m_EditorClassIdentifier:
  name: Data Rover
  minigameType: 111
  instructionsLabel: Recover the evidence - slip past the patrol sweeps
  resultOnTimeout: 0
  standardDuration: 75
  minigameUIPrefab: {fileID: 9120000000000001003, guid: da7a0e0011c42c8a90f31d5b6e7c9011, type: 3}
  descriptionImage: {fileID: 0}
  descriptionHeader: Data Rover - Evidence Expedition
  description: 'You pilot a recovery rover dropped into a hostile facility. Scattered
    across the arena are DATA SHARDS - the evidence you came to recover. Security
    bots sweep the floor on fixed patrol loops, each projecting an amber vision cone
    that cannot see through walls. Touching a bot or its cone costs 1 integrity and
    briefly scrambles your cloak. The patrols never change their routes - watch a
    loop, learn its timing window, then move. Drive with WASD or the arrow keys and
    collect every shard before the mission clock runs out. Lose all integrity or
    run out of time and the mission fails - patience beats speed.'
  roverIntegrity: 3
  roverSpeed: 2.9
  roverAcceleration: 14
  invulnerabilitySeconds: 1.5
  shardCount: 8
  layoutIndex: -1
  shardLabel: DATA SHARD
  patrolLabel: PATROL BOT
  patrolSpeed: 1.4
  visionRange: 2.6
  visionHalfAngle: 34
  pointsPerShard: 120
  timeBonusPerSecond: 12
  detectionPenalty: 90
