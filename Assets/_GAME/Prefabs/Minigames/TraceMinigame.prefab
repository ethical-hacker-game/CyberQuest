--- !u!114 &3091008480352795156
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 445104344373186524}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 36cc02a11cf2c5d4a89c71b4f78e8451, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  name: Trace the Intruder
  minigameType: 51
  instructionsLabel: Trace the intruder and cut them off
  resultOnTimeout: 0
  standardDuration: 120
  minigameUIPrefab: {fileID: 5767319996917168571, guid: 8fb6e618df535da4a82bafd53776ac27, type: 3}
  descriptionImage: {fileID: 0}
  descriptionHeader: Trace the Intruder
  description: 'An intruder is moving through the network RIGHT NOW. Reconstruct
    their path from the magenta entry to the yellow target - you can only move across
    links the attacker could actually use - then cut a link AHEAD of them to isolate
    the target. Every committed move you make (hops, backtracks, wrong cuts) lets
    the intruder advance along their route: if they reach the target first, the data
    is gone. Inspecting links is free, so read the evidence, plan, and act with as
    few moves as possible.'
  scenarios:
  - scenarioName: Finance foothold
    recommendedDifficulty: 1
    nodes:
    - id: ws
      label: WKS-FINANCE
      role: 1
      detail: Phished workstation, local-admin rights
      position: {x: 0.1, y: 0.5}
    - id: file
      label: FILE-SRV
      role: 0
      detail: SMB shares, cached credentials
      position: {x: 0.38, y: 0.75}
    - id: print
      label: PRINT-SRV
      role: 3
      detail: Isolated print VLAN
      position: {x: 0.38, y: 0.25}
    - id: app
      label: APP-02
      role: 0
      detail: Reused service account
      position: {x: 0.65, y: 0.55}
    - id: dc
      label: DC-01
      role: 2
      detail: Domain controller - crown jewels
      position: {x: 0.92, y: 0.5}
    links:
    - fromId: ws
      toId: file
      attackerCanTraverse: 1
      evidence: Reused local-admin hash (Pass-the-Hash)
      isContainmentPoint: 0
    - fromId: ws
      toId: print
      attackerCanTraverse: 0
      evidence: Print VLAN is segmented - no route from workstations
      isContainmentPoint: 0
    - fromId: file
      toId: app
      attackerCanTraverse: 1
      evidence: Cached service-account creds found on FILE-SRV
      isContainmentPoint: 0
    - fromId: print
      toId: app
      attackerCanTraverse: 0
      evidence: ACL blocks the print segment from reaching app servers
      isContainmentPoint: 0
    - fromId: app
      toId: dc
      attackerCanTraverse: 1
      evidence: The service account holds admin rights on the DC
      isContainmentPoint: 0
  - scenarioName: Two roads, one bridge
    recommendedDifficulty: 2
    nodes:
    - id: vpn
      label: VPN-GW
      role: 1
      detail: Contractor VPN gateway, stolen credentials
      position: {x: 0.08, y: 0.5}
    - id: mail
      label: MAIL-01
      role: 0
      detail: Mail gateway
      position: {x: 0.3, y: 0.78}
    - id: web
      label: WEB-DMZ
      role: 0
      detail: Public web server in the DMZ
      position: {x: 0.3, y: 0.22}
    - id: hr
      label: HR-PORTAL
      role: 3
      detail: HR self-service portal
      position: {x: 0.28, y: 0.5}
    - id: jump
      label: JUMP-SRV
      role: 0
      detail: Admin jump server
      position: {x: 0.58, y: 0.5}
    - id: av
      label: AV-CONSOLE
      role: 3
      detail: Antivirus management console
      position: {x: 0.62, y: 0.84}
    - id: bak
      label: BACKUP-01
      role: 3
      detail: Backup server
      position: {x: 0.62, y: 0.16}
    - id: vault
      label: DATA-VAULT
      role: 2
      detail: Research data vault - crown jewels
      position: {x: 0.9, y: 0.5}
    links:
    - fromId: vpn
      toId: mail
      attackerCanTraverse: 1
      evidence: Contractor password reused on the mail gateway
      isContainmentPoint: 0
    - fromId: vpn
      toId: web
      attackerCanTraverse: 1
      evidence: Web shell planted through an unpatched CMS plugin
      isContainmentPoint: 0
    - fromId: vpn
      toId: hr
      attackerCanTraverse: 0
      evidence: HR portal sits behind SSO with enforced MFA
      isContainmentPoint: 0
    - fromId: mail
      toId: jump
      attackerCanTraverse: 1
      evidence: Admin left an open RDP session on the jump server
      isContainmentPoint: 0
    - fromId: web
      toId: jump
      attackerCanTraverse: 1
      evidence: Legacy firewall rule lets the DMZ reach the jump server
      isContainmentPoint: 0
    - fromId: mail
      toId: av
      attackerCanTraverse: 0
      evidence: AV console requires a smartcard logon
      isContainmentPoint: 0
    - fromId: web
      toId: bak
      attackerCanTraverse: 0
      evidence: Backup VLAN accepts traffic only from the management subnet
      isContainmentPoint: 0
    - fromId: jump
      toId: vault
      attackerCanTraverse: 1
      evidence: The vault whitelists the jump server address
      isContainmentPoint: 0
  - scenarioName: Pipeline breach
    recommendedDifficulty: 3
    nodes:
    - id: kiosk
      label: KIOSK-LOBBY
      role: 1
      detail: Lobby kiosk, exposed USB port
      position: {x: 0.05, y: 0.4}
    - id: wifi
      label: GUEST-AP
      role: 3
      detail: Guest Wi-Fi access point
      position: {x: 0.12, y: 0.75}
    - id: iot
      label: CAM-NVR
      role: 0
      detail: Camera recorder, default admin password
      position: {x: 0.22, y: 0.52}
    - id: eng
      label: ENG-WS
      role: 0
      detail: Engineering workstation
      position: {x: 0.38, y: 0.5}
    - id: fin
      label: FIN-APP
      role: 3
      detail: Finance application server
      position: {x: 0.36, y: 0.14}
    - id: build
      label: BUILD-SRV
      role: 0
      detail: Build server
      position: {x: 0.52, y: 0.8}
    - id: git
      label: GIT-01
      role: 0
      detail: Source repository
      position: {x: 0.56, y: 0.45}
    - id: sec
      label: SIEM-01
      role: 3
      detail: Security monitoring
      position: {x: 0.68, y: 0.85}
    - id: ci
      label: CI-RUNNER
      role: 0
      detail: Build pipeline runner
      position: {x: 0.73, y: 0.5}
    - id: prod
      label: PROD-DB
      role: 2
      detail: Production database - crown jewels
      position: {x: 0.93, y: 0.45}
    links:
    - fromId: kiosk
      toId: iot
      attackerCanTraverse: 1
      evidence: Kiosk and cameras share one flat facilities VLAN
      isContainmentPoint: 0
    - fromId: kiosk
      toId: wifi
      attackerCanTraverse: 0
      evidence: Guest Wi-Fi enforces client isolation
      isContainmentPoint: 0
    - fromId: iot
      toId: eng
      attackerCanTraverse: 1
      evidence: NVR web console stores a saved engineering login
      isContainmentPoint: 0
    - fromId: eng
      toId: build
      attackerCanTraverse: 1
      evidence: Engineers mount the build share with cached domain creds
      isContainmentPoint: 0
    - fromId: eng
      toId: git
      attackerCanTraverse: 1
      evidence: The same domain account has push rights on GIT-01
      isContainmentPoint: 0
    - fromId: build
      toId: git
      attackerCanTraverse: 1
      evidence: Build server syncs repositories over a trusted service account
      isContainmentPoint: 0
    - fromId: eng
      toId: fin
      attackerCanTraverse: 0
      evidence: Finance app enforces per-user MFA
      isContainmentPoint: 0
    - fromId: build
      toId: sec
      attackerCanTraverse: 0
      evidence: SIEM lives on an isolated management VLAN
      isContainmentPoint: 0
    - fromId: git
      toId: ci
      attackerCanTraverse: 1
      evidence: CI runner executes any pipeline pushed to the repository
      isContainmentPoint: 0
    - fromId: ci
      toId: prod
      attackerCanTraverse: 1
      evidence: The runner holds a deploy key to the production database
      isContainmentPoint: 0
  randomMirror: 1
  attackerStepEvery: 3
  evidenceVisibleByDefault: 1
  pointsPerHop: 120
  wrongHopPenalty: 40
  wrongCutPenalty: 80
  timeBonusPerSecond: 6
  containmentBonus: 400
  bonusPerAttackerDistance: 60
  optimalCutBonus: 200
