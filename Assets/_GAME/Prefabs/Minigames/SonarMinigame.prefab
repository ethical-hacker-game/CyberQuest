  m_Script: {fileID: 11500000, guid: 50a7500e01c42c8a90f31d5b6e7c5001, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  name: Sonar Sweep
  minigameType: 121
  instructionsLabel: Mark the real caches - ignore the false echoes
  resultOnTimeout: 0
  standardDuration: 75
  minigameUIPrefab: {fileID: 9122000000000001003, guid: 50a7500e11c42c8a90f31d5b6e7c5011, type: 3}
  descriptionImage: {fileID: 0}
  descriptionHeader: Sonar Sweep - Read the Signal
  description: 'A dark scanner arena. A sonar fan sweeps from the station in the middle,
    and the blips it passes over flash and then fade in the dark - you only ever see
    what you just scanned. Genuine DATA CACHES hold a steady, sharp signal; FALSE
    ECHOES flicker and wobble like interference. In the fading window, click the ones
    you judge to be real caches. Clicking a false echo overloads the scanner and costs
    1 integrity, so verify how a blip behaves before you react. Contacts drift around the
    arena and new ones keep fading in over time, so keep sweeping - you cannot clear them
    all in one pass. Mark every cache before the clock runs out to win - patience beats
    reflex, because false positives cost.'
  scanIntegrity: 3
  cacheCount: 6
  initialCacheCount: 2
  cacheSpawnInterval: 7
  falseEchoCount: 6
  maxConcurrentEchoes: 10
  extraEchoInterval: 8
  secondsPerRevolution: 6
  afterglowSeconds: 2.3
  fanHalfAngleStart: 26
  fanHalfAngleEnd: 15
  fanNarrowSeconds: 55
  pointsPerCache: 130
  freshSweepBonus: 60
  falseEchoPenalty: 90
  timeBonusPerSecond: 12
  cacheLabel: DATA CACHE
  echoLabel: FALSE ECHO
