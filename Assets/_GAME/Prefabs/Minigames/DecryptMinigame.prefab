--- !u!114 &-7383881310895298116
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 445104344373186524}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dec19a7a003b42c8a90f31d5b6e7c803, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  name: Decrypt the Intercept
  minigameType: 71
  instructionsLabel: Peel the encoding layers and read the intercept
  resultOnTimeout: 0
  standardDuration: 150
  minigameUIPrefab: {fileID: 6100000000000001003, guid: dec19a7a011b42c8a90f31d5b6e7c811, type: 3}
  descriptionImage: {fileID: 0}
  descriptionHeader: Decrypt the Intercept
  description: We intercepted a transmission from the intruders - but it is wrapped
    in layers of classic encodings. Read the free SIGNAL ANALYSIS panel, recognise
    the signature of the OUTERMOST layer (Base64 charset with = padding, hex digits,
    letter frequencies for substitution ciphers), then apply the matching decoder
    to peel it. A wrong decode costs points and burns one of your limited attempts
    - run out and the intercept wipes itself. Recover the plaintext before the timer
    expires. Analysis is free; guessing is not.
  scenarios:
  - scenarioName: Dead drop
    recommendedDifficulty: 1
    plaintext: MEET AT THE OLD SERVER ROOM AFTER THE NIGHT SHIFT AND BRING THE BACKUP
      DRIVE
    steps:
    - type: 0
      caesarShift: 3
    - type: 1
      caesarShift: 3
  - scenarioName: Exfil beacon
    recommendedDifficulty: 1
    plaintext: UPLOAD COMPLETE FIFTY GIGABYTES OF CUSTOMER RECORDS STAGED ON HOST
      TEN DOT FOUR
    steps:
    - type: 3
      caesarShift: 3
    - type: 1
      caesarShift: 3
  - scenarioName: Cover story
    recommendedDifficulty: 1
    plaintext: TELL SECURITY THE CONTRACTOR BADGE WAS LOST AND REQUEST A TEMPORARY
      REPLACEMENT
    steps:
    - type: 4
      caesarShift: 3
    - type: 2
      caesarShift: 3
  - scenarioName: Mirror drop
    recommendedDifficulty: 1
    plaintext: REVERSE THE WIRE TRANSFER BEFORE THE BANK CLOSES OR WE LOSE EVERYTHING
    steps:
    - type: 3
      caesarShift: 3
    - type: 4
      caesarShift: 3
  - scenarioName: C2 callback
    recommendedDifficulty: 2
    plaintext: CONNECT TO COMMAND SERVER ON PORT EIGHT ZERO EIGHT ZERO EVERY TEN
      MINUTES
    steps:
    - type: 0
      caesarShift: 4
    - type: 1
      caesarShift: 3
  - scenarioName: Ransom note
    recommendedDifficulty: 2
    plaintext: PAY TWO BITCOIN WITHIN FORTY EIGHT HOURS OR THE FILES GO PUBLIC
    steps:
    - type: 3
      caesarShift: 3
    - type: 2
      caesarShift: 3
  - scenarioName: Ghost vendor
    recommendedDifficulty: 2
    plaintext: THE VENDOR INVOICE IS FAKE THE ACCOUNT NUMBER POINTS OFFSHORE
    steps:
    - type: 4
      caesarShift: 3
    - type: 1
      caesarShift: 3
  - scenarioName: Burner phone
    recommendedDifficulty: 2
    plaintext: CALL THE NEW NUMBER ONLY FROM THE BURNER NEVER FROM YOUR DESK PHONE
    steps:
    - type: 0
      caesarShift: 2
    - type: 4
      caesarShift: 3
    - type: 1
      caesarShift: 3
  - scenarioName: Wire fraud
    recommendedDifficulty: 3
    plaintext: MOVE THE FUNDS THROUGH THREE SHELL ACCOUNTS BEFORE THE AUDIT BEGINS
      ON MONDAY
    steps:
    - type: 4
      caesarShift: 3
    - type: 3
      caesarShift: 3
    - type: 2
      caesarShift: 3
  - scenarioName: Insider handoff
    recommendedDifficulty: 3
    plaintext: THE BADGE CODE FOR THE DATA CENTER CHANGES ON FRIDAY USE FOUR SEVEN
      NINE TWO
    steps:
    - type: 0
      caesarShift: 2
    - type: 3
      caesarShift: 3
    - type: 1
      caesarShift: 3
  - scenarioName: Deep cover
    recommendedDifficulty: 3
    plaintext: THE SLEEPER AGENT KEEPS HER CREDENTIALS TAPED UNDER THE THIRD DESK
      DRAWER
    steps:
    - type: 0
      caesarShift: 3
    - type: 4
      caesarShift: 3
    - type: 3
      caesarShift: 3
    - type: 1
      caesarShift: 3
  wrongAttemptsAllowed: 5
  layersVisibleByDefault: 1
  pointsPerLayer: 150
  wrongAttemptPenalty: 60
  decryptBonus: 300
  timeBonusPerSecond: 6
  bonusPerAttemptLeft: 50
