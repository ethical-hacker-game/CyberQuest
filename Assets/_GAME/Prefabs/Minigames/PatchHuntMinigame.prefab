  m_EditorClassIdentifier:
  name: Patch Hunt
  minigameType: 101
  instructionsLabel: Patch the breaches - do not touch the honeypot decoys
  resultOnTimeout: 1
  standardDuration: 60
  minigameUIPrefab: {fileID: 9201000000000001003, guid: ba7c4a011c42d8a90f31d5b6e7c90011, type: 3}
  descriptionImage: {fileID: 0}
  descriptionHeader: Patch Hunt - Triage the Server Room
  description: 'A neon server room is under attack. Red BREACH eruptions burst from
    the racks, each with a shrinking timer ring - aim with the mouse and click every
    breach before its ring closes. Each breach that slips through costs 1 integrity;
    at zero the racks go dark and the run is lost. Green HONEYPOT decoys look almost
    identical to breaches: clicking one costs points and resets your combo, so look
    at what you are clicking before you act. Chain clean patches to build a combo
    multiplier and survive until the end of the shift. Triage before action - that
    is the whole job of incident response.'
  gridColumns: 4
  gridRows: 3
  integrity: 3
  spawnInterval: 1.7
  minSpawnInterval: 0.75
  spawnRampSeconds: 40
  breachLifetime: 2.6
  minBreachLifetime: 1.2
  honeypotChance: 0.25
  maxSimultaneous: 3
  pointsPerPatch: 100
  speedBonusMax: 60
  missPenalty: 40
  honeypotPenalty: 120
  breachLabel: BREACH
  honeypotLabel: HONEYPOT
