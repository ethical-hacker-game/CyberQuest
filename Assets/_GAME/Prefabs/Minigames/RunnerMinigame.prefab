  m_Script: {fileID: 11500000, guid: 9ac4e7a001b42c8a90f31d5b6e7c8001, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  name: Packet Rush
  minigameType: 91
  instructionsLabel: Steer the payload - route around hostile infrastructure
  resultOnTimeout: 1
  standardDuration: 60
  minigameUIPrefab: {fileID: 9200000000000001003, guid: 9ac4e7a011b42c8a90f31d5b6e7c8011, type: 3}
  descriptionImage: {fileID: 0}
  descriptionHeader: Packet Rush - Route the Payload
  description: 'You ARE the packet: an emergency security patch rolling down the
    backbone toward a quarantined server. Hostile infrastructure litters the three
    fibers - red FIREWALL barriers, purple MALWARE mines and orange SNIFFER blades.
    Use the big side buttons (or A / D and the arrow keys) to swerve the packet cube
    between lanes and route around every hazard - a clear path always exists. Grab
    cyan DATA crystals for points and green PATCH pickups to restore integrity.
    Every hit costs 1 packet integrity; at zero the packet is dropped. Survive until
    the delivery window closes and the payload arrives. Every lane switch is a
    re-routing decision - the same thing dynamic routing does for real networks
    under attack.'
  packetIntegrity: 3
  startSpeed: 0.35
  maxSpeed: 0.8
  speedRampSeconds: 45
  spawnInterval: 1.5
  minSpawnInterval: 0.85
  hazardChance: 0.6
  dataShardChance: 0.35
  patchChance: 0.12
  pointsPerDodge: 15
  dataShardPoints: 120
  patchPoints: 60
  hitPenalty: 90
