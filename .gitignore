# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app
!Assets/_CONTENT/**/*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

UserSettings/
Assets/_PROTOTYPING/
Assets/BuildReports/
.claude/

# Scratch space and generated tooling output
tmp/
output/
__pycache__/

# Local dependencies and excluded optional utilities
/Assets/Beam - Complete Fluent UI/
/Assets/Beam - Complete Fluent UI.meta
/Assets/Chart And Graph/
/Assets/Chart And Graph.meta
/Assets/GIGA Softworks/
/Assets/GIGA Softworks.meta
/Assets/Plugins/
/Assets/Plugins.meta
/Assets/TextMesh Pro/
/Assets/TextMesh Pro.meta
/Assets/WorldMapStrategyKit/
/Assets/WorldMapStrategyKit.meta
/Assets/WorldPoliticalMapGlobeEdition/
/Assets/WorldPoliticalMapGlobeEdition.meta
/Assets/_ASSETS/Beam - Complete Fluent UI/
/Assets/_ASSETS/Beam - Complete Fluent UI.meta
/Assets/_ASSETS/Chart And Graph/
/Assets/_ASSETS/Chart And Graph.meta
/Assets/_ASSETS/Simple Vector Icons/
/Assets/_ASSETS/Simple Vector Icons.meta
/Assets/_ASSETS/TextMeshPro Examples & Extras/
/Assets/_ASSETS/TextMeshPro Examples & Extras.meta
/Assets/_ASSETS/WorldPoliticalMapGlobeEdition/
/Assets/_ASSETS/WorldPoliticalMapGlobeEdition.meta
/Assets/_ASSETS/Textures/Map/
/Assets/_ASSETS/Textures/Map.meta
/Assets/_ASSETS/Audio/Dark Fantasy Studio - The Lab/
/Assets/_ASSETS/Audio/Dark Fantasy Studio - The Lab.meta
/Assets/ConsolePro/
/Assets/ConsolePro.meta
/Assets/Fullscreen/
/Assets/Fullscreen.meta
/Assets/Hierarchy 2/
/Assets/Hierarchy 2.meta
/Assets/com.teamon.screenshooter/
/Assets/com.teamon.screenshooter.meta
/Assets/_ASSETS/_Other/
/Assets/_ASSETS/_Other.meta
/Assets/Editor/Setting/
/Assets/Editor/Setting.meta
/Packages/CustonToolbar/
/Packages/CustonToolbar.meta

# Private tooling, local configuration and distribution output
/.mcp.json
/.agents/
/.codex/
/PrivateArchives/
/Docs/
/steam_appid.txt
*.pyc

# Restored map resources and local dependency preparation
/Assets/_ASSETS/WorldMapStrategyKit/
/Assets/_ASSETS/WorldMapStrategyKit.meta
/.cyberquest-local-project.json
/.cyberquest-setup-*/
